# --- LLM（OpenAI互換のチャットAPI） ---
# デフォルトは同梱のモックLLM（実データ・外部AIに一切つながらない）
LLM_BASE_URL=http://mock-llm:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=mock

# OpenAI API を使う例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-6-luna

# ローカルLLMを使う例
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=xxxxxxxx
# LLM_MODEL=xxxxxxxx
