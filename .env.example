# --- LLM（OpenAI互換のチャットAPI） ---
# デフォルトは同梱のモックLLM（実データ・外部AIに一切つながらない）
LLM_BASE_URL=http://mock-llm:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=mock

# OpenAI API を使う例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-6-luna

# ローカルLLMを使う例
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=xxxxxxxx
# LLM_MODEL=xxxxxxxx

# LLMを同時に呼ぶ数（所員は並列に動く。サーバーが1台なら小さく）
# LLM_CONCURRENCY=2
# 1回の呼び出しを待つ秒数（これを過ぎると失敗として扱う）
# LLM_TIMEOUT=300

# --- 検索ソース ---
# 設定したソースだけが画面に出る。トークンは自分のアカウントのものを使う

# GitHub（Issue・Pull Request）
# GITHUB_TOKEN=github_pat_xxxxxxxx
# 検索範囲を絞る（GitHubの検索修飾子。省略するとトークンで見られる全体）
# GITHUB_SCOPE=org:my-org
# GitHub Enterprise Server のときだけ
# GITHUB_API_URL=https://github.example.com/api/v3

# GitLab（Issue・Merge Request）
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=glpat-xxxxxxxx
# 検索範囲をグループに絞る（省略するとトークンで見られる全体）
# GITLAB_GROUP=infra

# Zulip（チャンネルのメッセージとDM）
# APIキーは Zulip の「個人設定 → アカウントとプライバシー → APIキー」
# ZULIP_URL=https://zulip.example.com
# ZULIP_EMAIL=me@example.com
# ZULIP_API_KEY=xxxxxxxx

# MCPサーバー（書き方は README）。省略すると data/mcp.json を読む
# MCP_CONFIG=/work/data/mcp.json
